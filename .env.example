# AI API Keys (at least one is required)
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL_PROVIDER=anthropic  # or gemini, openai

# External services
FIRECRAWL_API_KEY=your_firecrawl_api_key

# MongoDB connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=whitelist_hub

# Redis configuration (for caching/queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Blockchain RPC URLs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_key
BSC_RPC_URL=https://bsc-dataseed.binance.org/
POLYGON_RPC_URL=https://polygon-rpc.com/

# API settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost"]
